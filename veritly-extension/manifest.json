{
    "manifest_version": 3,
    "name": "Veritly Sourcing",
    "version": "5.4",
    "description": "Exporta perfiles de LinkedIn a tu Pipeline de Veritly.",
    "permissions": [
        "sidePanel",
        "storage",
        "activeTab",
        "tabs"
    ],
    "host_permissions": [
        "https://www.linkedin.com/in/*",
        "https://*.firebaseio.com/*",
        "https://*.googleapis.com/*"
    ],
    "action": {
        "default_title": "Veritly Sourcing"
    },
    "side_panel": {
        "default_path": "sidepanel/sidepanel.html"
    },
    "background": {
        "service_worker": "background/background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://www.linkedin.com/in/*"],
            "js": ["content/content.js"],
            "css": ["content/content.css"]
        }
    ]
}