# Netlify aplica este archivo ANTES que las reglas de netlify.toml.
#
# Dominio corto vjobs.app: solo paginas publicas. vjobs.app/{slug} es la pagina
# de empleos (app/[slug].tsx), vjobs.app/v/{slug} el link corto de una vacante.
# Todo lo demas (postular, login, panel) va a veritlyapp.com, para que el
# candidato no tenga una sesion distinta por dominio. Las reglas sin "!" no
# tapan archivos que existen (bundle, favicon, etc.).
https://www.vjobs.app/*  https://vjobs.app/:splat        301!
https://vjobs.app/       https://veritlyapp.com/          302!
https://vjobs.app/v/*    /v/%5Bslug%5D.html               200
https://vjobs.app/e/*    https://vjobs.app/:splat         301
https://vjobs.app/:slug  /%5Bslug%5D.html                 200
https://vjobs.app/*      https://veritlyapp.com/:splat    301

# Rutas dinamicas: Expo pre-genera un HTML por cada una (vacante/[id].html, etc.,
# con el bundle de la app). Sin estas reglas caian al index.html y se veia la
# landing un instante antes de la pagina real. Netlify guarda esos archivos con
# los corchetes codificados (%5B / %5D).
/vacante/*         /vacante/%5Bid%5D.html         200
/v/*               /v/%5Bslug%5D.html             200
/e/*               /e/%5Bslug%5D.html             200
/empresa/job/*     /empresa/job/%5Bid%5D.html     200
/empresa/invite/*  /empresa/invite/%5Bcode%5D.html  200
/encuesta/*        /encuesta/%5Btipo%5D.html      200

# Archivos del bundle o de assets que no existen (ej. una pagina vieja guardada
# por el navegador interno de LinkedIn pide chunks de un deploy anterior): 404.
# Con el fallback de abajo recibian el index.html con 200 y el navegador lo
# ejecutaba como JS ("SyntaxError: Unexpected token '<'"). El 404 lo detecta
# app/+html.tsx y recarga la pagina una vez.
/_expo/*   /404.html  404
/assets/*  /404.html  404

# Todo lo demas sin archivo estatico: SPA fallback
/*  /index.html  200
